# Токен бота от @BotFather
BOT_TOKEN=
# 24 слова отдельного TON-кошелька под бота (через пробел). Никому не показывай этот файл!
WALLET_MNEMONIC=
# Адрес этого же кошелька (UQ... или EQ...)
WALLET_ADDRESS=
# Необязательно: ключ toncenter от @tonapibot — выдача быстрее
TONCENTER_KEY=
# Необязательно: если появится свой домен с HTTPS, например https://stars.example.com — туннель не нужен
PUBLIC_URL=
PORT=8787
